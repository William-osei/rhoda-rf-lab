# RHODA offline-first defaults. No API key or physical instrument is required.
# Copy to ignored .env.local only if that file does not already exist.
# Minimal simulator installs read backend settings from the shell environment.
# server/requirements-ai.txt additionally installs python-dotenv for .env.local.

SCOPE_RESOURCE=
SCOPE_SIMULATE=false
RHODA_AI_ENABLED=0
RHODA_AUTH_ENABLED=0
HOST=127.0.0.1
PORT=5001

# Browser API: empty uses the page's same-origin /api route.
# Vite dev and preview proxy /api to http://127.0.0.1:5001.
# Static production hosts must provide that route or set an explicit API URL.
VITE_INSTRUMENT_API=

# A separate backend requires the exact frontend origin in this comma-separated
# allowlist. Defaults permit HTTP localhost/127.0.0.1 on 8081, 4173 and 5173.
# Same-origin Vite proxy requests do not need a custom entry.
# RHODA_ALLOWED_ORIGINS=https://lab.example

# Optional server-only text AI. Installing dependencies does not enable requests.
# Set a real server credential and RHODA_AI_ENABLED=1 only when you choose to use it.
# Never put OPENAI_API_KEY in a VITE_* variable.
OPENAI_API_KEY=
RHODA_OPENAI_MODEL=gpt-5-mini

# Optional existing speech/vision providers; blank means unavailable.
# VITE_* values are exposed to the browser bundle. They are not server secrets.
VITE_GEMINI_API_KEY=
VITE_GHANANLP_API_KEY=

# Optional physical RTB connection: set an exact matching VISA address only when
# ready to connect real equipment. USB/AUTO require exactly one matching device.
# Keep SCOPE_SIMULATE=false: vendor simulation is a command cache, not RHODA training.
# Omitting SCOPE_RESOURCE selects RHODA's ideal training simulator.
# SCOPE_RESOURCE=USB0::0x0AAD::0x01D6::SERIAL::INSTR
# SCOPE_RESOURCE=TCPIP::INSTRUMENT_IP::INSTR

# Optional local resource root and durable session journal paths.
# RHODA_RESOURCE_ROOT=C:/path/to/R&S
# RHODA_SESSION_DB=C:/path/to/sessions.sqlite3

# Optional authenticated shared-lab pilot. Keep disabled for anonymous offline use.
# Setup, roles and deployment limits: AUTH-PILOT.md.
# Enabled mode fails startup if the secret/user configuration is missing or invalid.
# Users must have scrypt password hashes; create them with server/auth.py prompts.
# Never place an authentication secret or password in a VITE_* variable.
# RHODA_AUTH_ENABLED=1
# RHODA_AUTH_SECRET=
# RHODA_AUTH_USERS_FILE=C:/private/rhoda/users.json
# RHODA_AUTH_SESSION_SECONDS=7200
# RHODA_AUTH_COOKIE_SECURE=1
# Use RHODA_AUTH_COOKIE_SECURE=0 only for an explicit loopback HTTP test.
