{
  "name": "znle6-student-lab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Offline educational VNA ZNLE6 demonstration for students",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5186",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build && node scripts/build-offline.mjs && node scripts/verify-offline.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port 4186",
    "verify:offline": "node scripts/verify-offline.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
